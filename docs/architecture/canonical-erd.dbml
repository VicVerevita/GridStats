Project SimPaddock {
  database_type: 'PostgreSQL'
  Note: '''
  Canonical relational domain model for SimPaddock.

  Core principles:
  - Trusted sources establish history; claims establish authority to manage it.
  - Canonical records are separate from immutable source observations.
  - Source-backed entities may exist without any SimPaddock account.
  - Result and standing corrections create immutable revisions; evidence is never overwritten.
  - Historical team representation in a result is independent from explicit TeamMembership.
  - No hard deletion of historical facts in normal application flows.
  - UUID primary keys are intended to be UUIDv7 generated by the application/domain layer.
  - Public history/achievement/statistic read models are projections and are intentionally omitted.
  '''
}

TablePartial mutable_entity {
  id uuid [pk, note: 'UUIDv7; generated by the application/domain layer']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

TablePartial immutable_record {
  id uuid [pk, note: 'UUIDv7; generated by the application/domain layer']
  created_at timestamptz [not null, default: `now()`]
}


// ============================================================================
// IDENTITY & CLAIMS
// ============================================================================

Enum identity.account_status {
  active
  disabled
}

Enum identity.claim_status {
  pending
  approved
  rejected
  withdrawn
}

Enum identity.claim_kind {
  driver_existing
  team_existing
  organisation_existing
  team_create
  organisation_create
}

Enum identity.claim_evidence_kind {
  trusted_source_role
  existing_owner_approval
  auth_identity
  external_challenge
  manual_review
  other
}

Table identity.account {
  ~mutable_entity
  status identity.account_status [not null, default: 'active']
  last_login_at timestamptz

  Note: 'Login identity only. An Account is not a Driver and may hold Driver, Team-management and Organisation-management roles independently.'
}

Table identity.auth_identity {
  ~mutable_entity
  account_id uuid [not null]
  provider varchar(64) [not null, note: 'For example discord or steam']
  provider_subject varchar(255) [not null, note: 'Stable provider-side subject/account identifier']
  username_snapshot varchar(255)
  last_verified_at timestamptz

  indexes {
    (provider, provider_subject) [unique, name: 'uq_auth_identity_provider_subject']
    (account_id, provider) [unique, name: 'uq_auth_identity_account_provider']
  }
}

Table identity.claim {
  ~immutable_record
  account_id uuid [not null]
  kind identity.claim_kind [not null]
  status identity.claim_status [not null, default: 'pending']

  target_driver_id uuid
  target_team_id uuid
  target_organisation_id uuid

  decided_at timestamptz
  decided_by_account_id uuid
  decision_reason text

  checks {
    `num_nonnull(target_driver_id, target_team_id, target_organisation_id) <= 1` [name: 'chk_claim_at_most_one_existing_target']
    `(kind in ('team_create', 'organisation_create') and num_nonnull(target_driver_id, target_team_id, target_organisation_id) = 0) or (kind not in ('team_create', 'organisation_create') and num_nonnull(target_driver_id, target_team_id, target_organisation_id) = 1)` [name: 'chk_claim_target_required_by_kind']
  }

  Note: '''
  Historical claim request. Existing Driver/Team/Organisation claims point at exactly one canonical entity.
  Team/Organisation creation claims have no existing target; their proposed entity data lives in the corresponding creation_request table.
  '''
}

Table identity.claim_evidence {
  ~immutable_record
  claim_id uuid [not null]
  kind identity.claim_evidence_kind [not null]

  auth_identity_id uuid
  source_record_id uuid
  provided_by_account_id uuid
  details jsonb

  Note: 'Evidence supporting or reviewing a claim. The verification mechanism can evolve without changing Claim semantics.'
}

Table identity.driver_ownership {
  driver_id uuid [pk]
  account_id uuid [not null, unique]
  approved_claim_id uuid [not null, unique]
  established_at timestamptz [not null, default: `now()`]

  Note: 'Current one-to-one management ownership of a Driver Profile. Claims remain historical; this table is the current authorization link.'
}


// ============================================================================
// DRIVER REGISTRY
// ============================================================================

Table drivers.driver {
  ~mutable_entity
  slug varchar(120) [not null, unique]
  display_name varchar(255) [not null]
  country_code char(2) [note: 'Optional country selected by the Driver; not inferred from race-source flags']
  bio_markdown text
  avatar_object_key text [note: 'Object-storage key/URL; binary image data is not stored here']
  merged_into_driver_id uuid

  checks {
    `merged_into_driver_id is null or merged_into_driver_id <> id` [name: 'chk_driver_not_merged_into_self']
  }

  Note: 'Canonical sim-racing identity. May exist unclaimed. No legal-name requirement.'
}

Table drivers.driver_alias {
  ~immutable_record
  driver_id uuid [not null]
  name varchar(255) [not null]
  valid_from date
  valid_until date

  checks {
    `valid_until is null or valid_from is null or valid_until >= valid_from` [name: 'chk_driver_alias_valid_range']
  }

  indexes {
    (driver_id, name) [name: 'ix_driver_alias_driver_name']
    name [name: 'ix_driver_alias_name']
  }

  Note: 'Known former/alternate canonical names used for search and historical presentation.'
}

Table drivers.driver_slug_history {
  ~immutable_record
  driver_id uuid [not null]
  slug varchar(120) [not null, unique]
  retired_at timestamptz [not null]

  Note: 'Retired public slugs used for redirects after a canonical Driver slug changes.'
}

Table drivers.driver_social_link {
  ~mutable_entity
  driver_id uuid [not null]
  platform varchar(64) [not null]
  url text [not null]
  label varchar(120)
  sort_order integer [not null, default: 0]

  indexes {
    (driver_id, sort_order) [name: 'ix_driver_social_sort']
  }
}


// ============================================================================
// TEAM MANAGEMENT
// ============================================================================

Enum teams.membership_origin {
  source_backed
  mutual_approval
  admin
}

Enum teams.membership_request_type {
  join_request
  invitation
  update
}

Enum teams.membership_request_status {
  pending
  approved
  rejected
  cancelled
}

Enum teams.membership_request_initiator {
  driver
  team_management
}

Table teams.team {
  ~mutable_entity
  slug varchar(120) [not null, unique]
  display_name varchar(255) [not null]
  bio_markdown text
  logo_object_key text
  archived_at timestamptz
  merged_into_team_id uuid

  checks {
    `merged_into_team_id is null or merged_into_team_id <> id` [name: 'chk_team_not_merged_into_self']
  }

  Note: 'Canonical Team identity. Independent from Organisations and may participate across multiple competitions/organisations.'
}

Table teams.team_name_history {
  ~immutable_record
  team_id uuid [not null]
  name varchar(255) [not null]
  valid_from date
  valid_until date

  checks {
    `valid_until is null or valid_from is null or valid_until >= valid_from` [name: 'chk_team_name_valid_range']
  }
}

Table teams.team_slug_history {
  ~immutable_record
  team_id uuid [not null]
  slug varchar(120) [not null, unique]
  retired_at timestamptz [not null]
}

Table teams.team_social_link {
  ~mutable_entity
  team_id uuid [not null]
  platform varchar(64) [not null]
  url text [not null]
  label varchar(120)
  sort_order integer [not null, default: 0]
}

Table teams.team_creation_request {
  ~immutable_record
  claim_id uuid [not null, unique]
  proposed_name varchar(255) [not null]
  proposed_slug varchar(120)
  proposed_bio_markdown text
  approved_team_id uuid [unique]

  Note: 'Proposed Team for a team_create claim. The canonical Team is created only when the claim is approved.'
}

Table teams.team_membership {
  ~mutable_entity
  team_id uuid [not null]
  driver_id uuid [not null]
  start_date date
  end_date date
  origin teams.membership_origin [not null]
  approved_request_id uuid [unique]
  created_by_account_id uuid

  checks {
    `end_date is null or start_date is null or end_date >= start_date` [name: 'chk_team_membership_valid_range']
  }

  indexes {
    (team_id, driver_id) [name: 'ix_team_membership_team_driver']
    driver_id [name: 'ix_team_membership_driver']
    (id, team_id) [unique, name: 'uq_team_membership_id_team']
  }

  Note: '''
  Explicit Driver↔Team membership history. It is independent from team representation recorded in a ResultEntry.
  Overlapping memberships are allowed.
  '''
}

Table teams.team_membership_request {
  ~immutable_record
  team_id uuid [not null]
  driver_id uuid [not null]

  request_type teams.membership_request_type [not null]
  initiator teams.membership_request_initiator [not null]
  status teams.membership_request_status [not null, default: 'pending']

  requested_by_account_id uuid [not null]
  responded_by_account_id uuid
  responded_at timestamptz

  existing_membership_id uuid
  applied_membership_id uuid

  proposed_start_date date
  proposed_end_date date
  message text
  response_note text

  checks {
    `proposed_end_date is null or proposed_start_date is null or proposed_end_date >= proposed_start_date` [name: 'chk_membership_request_valid_range']
  }

  Note: '''
  Mutual-approval workflow. Driver-originated membership additions/updates require Team management approval.
  Team invitations require the Driver owner to accept.
  '''
}

Table teams.roster_role {
  ~mutable_entity
  team_id uuid [not null]
  name varchar(120) [not null]
  sort_order integer [not null, default: 0]

  indexes {
    (team_id, name) [unique, name: 'uq_roster_role_team_name']
    (id, team_id) [unique, name: 'uq_roster_role_id_team']
  }

  Note: 'Presentation/roster role such as Driver, Reserve Driver or Engineer. It carries no management permissions.'
}

Table teams.team_membership_role {
  team_id uuid [not null]
  team_membership_id uuid [not null]
  roster_role_id uuid [not null]
  assigned_at timestamptz [not null, default: `now()`]

  indexes {
    (team_membership_id, roster_role_id) [pk]
  }

  Note: 'team_id is intentionally repeated so the database can enforce that the Membership and roster Role belong to the same Team.'
}

Table teams.management_permission {
  code varchar(100) [pk]
  description text [not null]

  Note: 'System-supported Team management capability code.'
}

Table teams.management_role {
  ~mutable_entity
  team_id uuid [not null]
  name varchar(120) [not null]
  system_key varchar(64) [note: 'Reserved key for built-in roles such as owner']
  sort_order integer [not null, default: 0]
  is_system boolean [not null, default: false]

  indexes {
    (team_id, name) [unique, name: 'uq_team_management_role_name']
    (team_id, system_key) [unique, name: 'uq_team_management_role_system_key']
    (id, team_id) [unique, name: 'uq_team_management_role_id_team']
  }
}

Table teams.management_role_permission {
  management_role_id uuid [not null]
  permission_code varchar(100) [not null]

  indexes {
    (management_role_id, permission_code) [pk]
  }
}

Table teams.manager {
  ~mutable_entity
  team_id uuid [not null]
  account_id uuid [not null]
  active boolean [not null, default: true]

  indexes {
    (team_id, account_id) [unique, name: 'uq_team_manager_account']
    (id, team_id) [unique, name: 'uq_team_manager_id_team']
  }

  Note: 'Account-level Team management membership. Separate from Driver↔Team roster membership.'
}

Table teams.manager_role {
  team_id uuid [not null]
  manager_id uuid [not null]
  management_role_id uuid [not null]
  assigned_at timestamptz [not null, default: `now()`]
  assigned_by_account_id uuid

  indexes {
    (manager_id, management_role_id) [pk]
  }

  Note: 'team_id is intentionally repeated so cross-Team role assignment is impossible at the FK layer.'
}


// ============================================================================
// ORGANISATIONS & PERMISSIONS
// ============================================================================

Table organisations.organisation {
  ~mutable_entity
  slug varchar(120) [not null, unique]
  display_name varchar(255) [not null]
  bio_markdown text
  logo_object_key text
  archived_at timestamptz
  merged_into_organisation_id uuid

  checks {
    `merged_into_organisation_id is null or merged_into_organisation_id <> id` [name: 'chk_organisation_not_merged_into_self']
  }
}

Table organisations.organisation_name_history {
  ~immutable_record
  organisation_id uuid [not null]
  name varchar(255) [not null]
  valid_from date
  valid_until date

  checks {
    `valid_until is null or valid_from is null or valid_until >= valid_from` [name: 'chk_org_name_valid_range']
  }
}

Table organisations.organisation_slug_history {
  ~immutable_record
  organisation_id uuid [not null]
  slug varchar(120) [not null, unique]
  retired_at timestamptz [not null]
}

Table organisations.organisation_social_link {
  ~mutable_entity
  organisation_id uuid [not null]
  platform varchar(64) [not null]
  url text [not null]
  label varchar(120)
  sort_order integer [not null, default: 0]
}

Table organisations.organisation_creation_request {
  ~immutable_record
  claim_id uuid [not null, unique]
  proposed_name varchar(255) [not null]
  proposed_slug varchar(120)
  proposed_bio_markdown text
  approved_organisation_id uuid [unique]

  Note: 'Proposed Organisation for an organisation_create claim. Canonical Organisation creation occurs after claim approval.'
}

Table organisations.permission {
  code varchar(100) [pk]
  description text [not null]

  Note: 'System-supported Organisation capability code used by custom Discord-like roles.'
}

Table organisations.role {
  ~mutable_entity
  organisation_id uuid [not null]
  name varchar(120) [not null]
  system_key varchar(64) [note: 'Reserved key for built-in roles such as owner']
  sort_order integer [not null, default: 0]
  is_system boolean [not null, default: false]

  indexes {
    (organisation_id, name) [unique, name: 'uq_org_role_name']
    (organisation_id, system_key) [unique, name: 'uq_org_role_system_key']
    (id, organisation_id) [unique, name: 'uq_org_role_id_org']
  }
}

Table organisations.role_permission {
  role_id uuid [not null]
  permission_code varchar(100) [not null]

  indexes {
    (role_id, permission_code) [pk]
  }
}

Table organisations.member {
  ~mutable_entity
  organisation_id uuid [not null]
  account_id uuid [not null]
  active boolean [not null, default: true]

  indexes {
    (organisation_id, account_id) [unique, name: 'uq_org_member_account']
    (id, organisation_id) [unique, name: 'uq_org_member_id_org']
  }

  Note: 'Organisation staff membership belongs to an Account, not to a Driver.'
}

Table organisations.member_role {
  organisation_id uuid [not null]
  member_id uuid [not null]
  role_id uuid [not null]
  assigned_at timestamptz [not null, default: `now()`]
  assigned_by_account_id uuid

  indexes {
    (member_id, role_id) [pk]
  }

  Note: 'organisation_id is intentionally repeated so member and role must belong to the same Organisation.'
}


// ============================================================================
// MOTORSPORT CATALOG
// ============================================================================

Table catalog.game {
  ~mutable_entity
  slug varchar(120) [not null, unique]
  display_name varchar(255) [not null]
  merged_into_game_id uuid

  checks {
    `merged_into_game_id is null or merged_into_game_id <> id` [name: 'chk_game_not_merged_into_self']
  }
}

Table catalog.car {
  ~mutable_entity
  game_id uuid [not null]
  display_name varchar(255) [not null]
  manufacturer varchar(120)
  model varchar(180)
  merged_into_car_id uuid

  checks {
    `merged_into_car_id is null or merged_into_car_id <> id` [name: 'chk_car_not_merged_into_self']
  }

  Note: 'Game-specific car identity. The same real-world model in different sims is intentionally represented by distinct Car rows.'
}

Table catalog.car_class {
  ~mutable_entity
  game_id uuid [not null]
  display_name varchar(160) [not null]
  merged_into_car_class_id uuid

  checks {
    `merged_into_car_class_id is null or merged_into_car_class_id <> id` [name: 'chk_car_class_not_merged_into_self']
  }

  Note: 'Game-specific canonical class concept. Competition-specific class labels live in competitions.competition_class.'
}

Table catalog.circuit {
  ~mutable_entity
  display_name varchar(255) [not null]
  country_code char(2)
  merged_into_circuit_id uuid

  checks {
    `merged_into_circuit_id is null or merged_into_circuit_id <> id` [name: 'chk_circuit_not_merged_into_self']
  }
}

Table catalog.circuit_layout {
  ~mutable_entity
  circuit_id uuid [not null]
  display_name varchar(255) [not null]
  merged_into_circuit_layout_id uuid

  indexes {
    (id, circuit_id) [unique, name: 'uq_circuit_layout_id_circuit']
  }

  checks {
    `merged_into_circuit_layout_id is null or merged_into_circuit_layout_id <> id` [name: 'chk_circuit_layout_not_merged_into_self']
  }
}


// ============================================================================
// COMPETITION STRUCTURE
// ============================================================================

Table competitions.competition {
  ~mutable_entity
  slug varchar(160) [not null, unique]
  display_name varchar(255) [not null]
  description_markdown text

  game_id uuid [not null]

  year smallint
  start_date date
  end_date date
  cancelled_at timestamptz

  merged_into_competition_id uuid

  checks {
    `end_date is null or start_date is null or end_date >= start_date` [name: 'chk_competition_valid_range']
    `year is null or (year >= 1900 and year <= 2200)` [name: 'chk_competition_year_reasonable']
    `merged_into_competition_id is null or merged_into_competition_id <> id` [name: 'chk_competition_not_merged_into_self']
  }

  Note: '''
  One concrete occurrence of a competition, e.g. VMS 2026. There is no mandatory Season entity.
  Competition creation from unsupported history is admin/moderated rather than ordinary user-authored.
  '''
}

Table competitions.competition_slug_history {
  ~immutable_record
  competition_id uuid [not null]
  slug varchar(160) [not null, unique]
  retired_at timestamptz [not null]
}

Table competitions.competition_organisation {
  competition_id uuid [not null]
  organisation_id uuid [not null]

  relationship_label varchar(120) [note: 'Optional source-facing label such as organiser or co-organiser']
  is_primary boolean [not null, default: false]
  organisation_name_snapshot varchar(255) [note: 'Historical name used for this competition when evidenced']

  indexes {
    (competition_id, organisation_id) [pk]
  }

  Note: 'Allows a Competition to be organised by multiple Organisations while preserving historical naming.'
}

Table competitions.competition_class {
  ~mutable_entity
  competition_id uuid [not null]
  car_class_id uuid
  display_name varchar(160) [not null]
  sort_order integer [not null, default: 0]

  indexes {
    (competition_id, display_name) [unique, name: 'uq_competition_class_name']
  }

  Note: 'Competition-specific class/category such as LMGT3, GT3 Pro or GT3 Am. It may map to a canonical game-specific CarClass.'
}

Table competitions.round {
  ~mutable_entity
  competition_id uuid [not null]
  display_name varchar(255) [not null]
  sequence_no integer
  start_date date
  end_date date
  merged_into_round_id uuid

  indexes {
    (id, competition_id) [unique, name: 'uq_round_id_competition']
  }

  checks {
    `end_date is null or start_date is null or end_date >= start_date` [name: 'chk_round_valid_range']
    `sequence_no is null or sequence_no > 0` [name: 'chk_round_sequence_positive']
    `merged_into_round_id is null or merged_into_round_id <> id` [name: 'chk_round_not_merged_into_self']
  }

  Note: 'Optional source-backed grouping. Never invented merely because a schema expects a round.'
}

Table competitions.race {
  ~mutable_entity
  competition_id uuid [not null]
  round_id uuid

  display_name varchar(255) [not null]
  sequence_no integer

  starts_at timestamptz [note: 'Canonical instant stored in UTC']
  local_timezone varchar(100) [note: 'Optional IANA timezone retained only when supplied/known']

  circuit_id uuid
  circuit_layout_id uuid

  merged_into_race_id uuid

  checks {
    `sequence_no is null or sequence_no > 0` [name: 'chk_race_sequence_positive']
    `circuit_layout_id is null or circuit_id is not null` [name: 'chk_race_layout_requires_circuit']
    `merged_into_race_id is null or merged_into_race_id <> id` [name: 'chk_race_not_merged_into_self']
  }

  Note: 'Source-backed race/event. It always belongs directly to Competition; Round is optional.'
}


// ============================================================================
// RESULTS & STANDINGS
// ============================================================================

Enum results.classification_status {
  finished
  dnf
  dns
  dsq
  dnq
  nc
  unknown
}

Enum results.revision_origin {
  source_reconciliation
  manual_correction
  admin_correction
}

Table results.race_result {
  ~mutable_entity
  race_id uuid [not null]
  result_type varchar(64) [not null, default: 'race', note: 'Canonical key such as race, qualifying, sprint, or another source-backed type']
  display_name varchar(160)
  current_revision_id uuid

  indexes {
    (race_id, result_type) [unique, name: 'uq_race_result_type']
    (id, current_revision_id) [name: 'ix_race_result_current_revision']
  }

  Note: 'Stable identity of one canonical result type for a Race. Contents live in immutable ResultRevision rows.'
}

Table results.result_revision {
  ~immutable_record
  race_result_id uuid [not null]
  revision_number integer [not null]
  origin results.revision_origin [not null]
  reason text
  created_by_account_id uuid

  indexes {
    (race_result_id, revision_number) [unique, name: 'uq_result_revision_number']
    (id, race_result_id) [unique, name: 'uq_result_revision_id_parent']
  }

  checks {
    `revision_number > 0` [name: 'chk_result_revision_number_positive']
    `origin = 'source_reconciliation' or reason is not null` [name: 'chk_manual_result_revision_requires_reason']
  }

  Note: '''
  Immutable canonical result revision. Drag-reordering/correction creates a new revision rather than mutating an older one.
  '''
}

Table results.result_entry {
  ~immutable_record
  result_revision_id uuid [not null]
  sort_order integer [not null]

  overall_position integer
  class_position integer
  grid_position integer

  classification_status results.classification_status [not null, default: 'unknown']

  points numeric(12,4)
  laps_completed integer

  total_time_ms bigint
  best_lap_time_ms bigint
  gap_ms bigint
  gap_laps integer

  car_number varchar(32)

  team_id uuid
  team_name_snapshot varchar(255)

  car_id uuid
  car_name_snapshot varchar(255)

  competition_class_id uuid
  class_name_snapshot varchar(160)

  entry_name_snapshot varchar(255)

  indexes {
    (result_revision_id, sort_order) [unique, name: 'uq_result_entry_sort']
  }

  checks {
    `sort_order > 0` [name: 'chk_result_entry_sort_positive']
    `overall_position is null or overall_position > 0` [name: 'chk_result_entry_overall_position']
    `class_position is null or class_position > 0` [name: 'chk_result_entry_class_position']
    `grid_position is null or grid_position > 0` [name: 'chk_result_entry_grid_position']
    `laps_completed is null or laps_completed >= 0` [name: 'chk_result_entry_laps']
    `total_time_ms is null or total_time_ms >= 0` [name: 'chk_result_entry_total_time']
    `best_lap_time_ms is null or best_lap_time_ms >= 0` [name: 'chk_result_entry_best_lap']
    `gap_ms is null or gap_ms >= 0` [name: 'chk_result_entry_gap_ms']
    `gap_laps is null or gap_laps >= 0` [name: 'chk_result_entry_gap_laps']
  }

  Note: '''
  Historical classified entry in a specific immutable result revision.
  team_id records represented Team in THIS result and is not inferred from TeamMembership.
  Snapshot fields preserve source/historical naming even after canonical entities are renamed.
  '''
}

Table results.result_entry_driver {
  ~immutable_record
  result_entry_id uuid [not null]
  lineup_order integer [not null]

  driver_id uuid [note: 'Nullable when a source participant has no stable resolvable Driver identity']
  display_name_snapshot varchar(255) [not null]
  represented_country_code_snapshot char(2)

  indexes {
    (result_entry_id, lineup_order) [unique, name: 'uq_result_entry_driver_lineup']
    (result_entry_id, driver_id) [unique, name: 'uq_result_entry_driver_resolved_driver']
  }

  checks {
    `lineup_order > 0` [name: 'chk_result_entry_driver_lineup_positive']
  }

  Note: '''
  One participant within a ResultEntry. A ResultEntry can have 1..N drivers.
  If the trusted source provides only a malformed/name-only participant with no stable identity, driver_id remains NULL while the snapshot is preserved.
  '''
}

Table results.standing {
  ~mutable_entity
  competition_id uuid [not null]
  competition_class_id uuid
  display_name varchar(255) [not null]
  subject_kind varchar(64) [not null, note: 'Currently driver or team; intentionally extensible']
  current_revision_id uuid

  indexes {
    competition_id [name: 'ix_standing_competition']
    (id, current_revision_id) [name: 'ix_standing_current_revision']
  }
}

Table results.standing_revision {
  ~immutable_record
  standing_id uuid [not null]
  revision_number integer [not null]
  origin results.revision_origin [not null]
  reason text
  created_by_account_id uuid

  indexes {
    (standing_id, revision_number) [unique, name: 'uq_standing_revision_number']
    (id, standing_id) [unique, name: 'uq_standing_revision_id_parent']
  }

  checks {
    `revision_number > 0` [name: 'chk_standing_revision_number_positive']
    `origin = 'source_reconciliation' or reason is not null` [name: 'chk_manual_standing_revision_requires_reason']
  }
}

Table results.standing_entry {
  ~immutable_record
  standing_revision_id uuid [not null]
  sort_order integer [not null]

  position integer
  points numeric(12,4)

  driver_id uuid
  team_id uuid

  subject_name_snapshot varchar(255) [not null]

  indexes {
    (standing_revision_id, sort_order) [unique, name: 'uq_standing_entry_sort']
  }

  checks {
    `sort_order > 0` [name: 'chk_standing_entry_sort_positive']
    `position is null or position > 0` [name: 'chk_standing_entry_position']
    `num_nonnull(driver_id, team_id) <= 1` [name: 'chk_standing_entry_at_most_one_canonical_subject']
  }

  Note: '''
  One classified standing subject. A row always represents one source subject via subject_name_snapshot.
  driver_id/team_id are optional canonical-resolution links; both may be NULL for unresolved/corrupt source data.
  '''
}


// ============================================================================
// INTEGRATION & PROVENANCE
// ============================================================================

Enum integrations.source_record_status {
  active
  withdrawn
  unavailable
}

Enum integrations.import_batch_status {
  running
  succeeded
  partial
  failed
}

Enum integrations.reconciliation_status {
  pending
  resolved
  dismissed
}

Table integrations.source_system {
  ~mutable_entity
  code varchar(64) [not null, unique]
  display_name varchar(120) [not null]
  base_url text
  trusted_for_auto_creation boolean [not null, default: true]

  Note: 'Trusted source definition such as SimGrid, Grid Finder or RaceControl.'
}

Table integrations.import_batch {
  ~immutable_record
  source_system_id uuid [not null]
  status integrations.import_batch_status [not null]
  started_at timestamptz [not null]
  finished_at timestamptz
  cursor_data jsonb
  error_summary text

  checks {
    `finished_at is null or finished_at >= started_at` [name: 'chk_import_batch_time_range']
  }
}

Table integrations.source_record {
  ~mutable_entity
  source_system_id uuid [not null]
  object_type varchar(100) [not null]
  external_id varchar(255) [not null]

  status integrations.source_record_status [not null, default: 'active']
  first_seen_at timestamptz [not null]
  last_seen_at timestamptz [not null]
  current_version_id uuid

  indexes {
    (source_system_id, object_type, external_id) [unique, name: 'uq_source_record_external_identity']
    (id, source_system_id) [unique, name: 'uq_source_record_id_source']
  }

  checks {
    `last_seen_at >= first_seen_at` [name: 'chk_source_record_seen_range']
  }

  Note: '''
  Stable identity of one object in one external source.
  External deletion never deletes canonical history; this row is marked withdrawn/unavailable.
  '''
}

Table integrations.source_record_version {
  ~immutable_record
  source_record_id uuid [not null]
  import_batch_id uuid [not null]

  source_updated_at timestamptz
  retrieved_at timestamptz [not null]

  payload_hash varchar(64) [not null]
  raw_payload jsonb
  is_tombstone boolean [not null, default: false]

  indexes {
    (source_record_id, payload_hash) [unique, name: 'uq_source_record_version_payload']
    (id, source_record_id) [unique, name: 'uq_source_version_id_record']
  }

  Note: 'Immutable evidence snapshot. Raw payload retention is subject to the source terms/API rules.'
}


// ---- Typed canonical references --------------------------------------------

Table integrations.driver_external_reference {
  ~mutable_entity
  source_system_id uuid [not null]
  source_record_id uuid [not null, unique]
  driver_id uuid [not null]

  external_display_name varchar(255)
  external_url text

  indexes {
    (driver_id, source_system_id) [unique, name: 'uq_driver_one_profile_per_source']
  }

  Note: 'A Driver may have at most one canonical profile mapping per source system.'
}

Table integrations.team_external_reference {
  ~mutable_entity
  source_system_id uuid [not null]
  source_record_id uuid [not null, unique]
  team_id uuid [not null]
  external_display_name varchar(255)
  external_url text
}

Table integrations.team_membership_external_reference {
  ~mutable_entity
  source_system_id uuid [not null]
  source_record_id uuid [not null, unique]
  team_membership_id uuid [not null]

  Note: 'Used only when the trusted source explicitly establishes membership, not merely race representation.'
}

Table integrations.organisation_external_reference {
  ~mutable_entity
  source_system_id uuid [not null]
  source_record_id uuid [not null, unique]
  organisation_id uuid [not null]
  external_display_name varchar(255)
  external_url text
}

Table integrations.competition_external_reference {
  ~mutable_entity
  source_system_id uuid [not null]
  source_record_id uuid [not null, unique]
  competition_id uuid [not null]
  external_display_name varchar(255)
  external_url text
}

Table integrations.competition_class_external_reference {
  ~mutable_entity
  source_system_id uuid [not null]
  source_record_id uuid [not null, unique]
  competition_class_id uuid [not null]
  external_display_name varchar(255)
}

Table integrations.round_external_reference {
  ~mutable_entity
  source_system_id uuid [not null]
  source_record_id uuid [not null, unique]
  round_id uuid [not null]
  external_display_name varchar(255)
}

Table integrations.race_external_reference {
  ~mutable_entity
  source_system_id uuid [not null]
  source_record_id uuid [not null, unique]
  race_id uuid [not null]
  external_display_name varchar(255)
  external_url text
}

Table integrations.result_external_reference {
  ~mutable_entity
  source_system_id uuid [not null]
  source_record_id uuid [not null, unique]
  race_result_id uuid [not null]
  external_display_name varchar(255)
  external_url text
}

Table integrations.standing_external_reference {
  ~mutable_entity
  source_system_id uuid [not null]
  source_record_id uuid [not null, unique]
  standing_id uuid [not null]
  external_display_name varchar(255)
  external_url text
}

Table integrations.game_external_reference {
  ~mutable_entity
  source_system_id uuid [not null]
  source_record_id uuid [not null, unique]
  game_id uuid [not null]
  external_display_name varchar(255)
}

Table integrations.car_external_reference {
  ~mutable_entity
  source_system_id uuid [not null]
  source_record_id uuid [not null, unique]
  car_id uuid [not null]
  external_display_name varchar(255)
}

Table integrations.car_class_external_reference {
  ~mutable_entity
  source_system_id uuid [not null]
  source_record_id uuid [not null, unique]
  car_class_id uuid [not null]
  external_display_name varchar(255)
}

Table integrations.circuit_external_reference {
  ~mutable_entity
  source_system_id uuid [not null]
  source_record_id uuid [not null, unique]
  circuit_id uuid [not null]
  external_display_name varchar(255)
}

Table integrations.circuit_layout_external_reference {
  ~mutable_entity
  source_system_id uuid [not null]
  source_record_id uuid [not null, unique]
  circuit_layout_id uuid [not null]
  external_display_name varchar(255)
}


// ---- Normalized immutable result observations ------------------------------

Table integrations.result_observation {
  ~immutable_record
  source_record_version_id uuid [not null, unique]
  result_type varchar(64) [not null]
  parsed_at timestamptz [not null]

  Note: 'Normalized immutable interpretation of one source result payload/version, kept separate from canonical ResultRevision.'
}

Table integrations.result_observation_entry {
  ~immutable_record
  result_observation_id uuid [not null]
  source_entry_key varchar(255)
  sort_order integer [not null]

  overall_position integer
  class_position integer
  grid_position integer

  normalized_status results.classification_status [not null, default: 'unknown']
  source_status_snapshot varchar(120)

  points numeric(12,4)
  laps_completed integer
  total_time_ms bigint
  best_lap_time_ms bigint
  gap_ms bigint
  gap_laps integer
  car_number varchar(32)

  team_external_reference_id uuid
  team_name_snapshot varchar(255)

  car_external_reference_id uuid
  car_name_snapshot varchar(255)

  competition_class_external_reference_id uuid
  class_name_snapshot varchar(160)

  entry_name_snapshot varchar(255)

  indexes {
    (result_observation_id, sort_order) [unique, name: 'uq_result_observation_entry_sort']
  }
}

Table integrations.result_observation_driver {
  ~immutable_record
  result_observation_entry_id uuid [not null]
  lineup_order integer [not null]

  driver_external_reference_id uuid
  external_driver_id_snapshot varchar(255)
  display_name_snapshot varchar(255) [not null]
  represented_country_code_snapshot char(2)

  indexes {
    (result_observation_entry_id, lineup_order) [unique, name: 'uq_result_observation_driver_lineup']
  }

  Note: '''
  If no stable external driver identity exists, driver_external_reference_id remains NULL.
  The source participant is preserved as observation data and is not automatically promoted to a public canonical Driver.
  '''
}

Table integrations.result_revision_evidence {
  result_revision_id uuid [not null]
  result_observation_id uuid [not null]
  evidence_role varchar(64) [not null, default: 'supporting']

  indexes {
    (result_revision_id, result_observation_id) [pk]
  }
}


// ---- Normalized immutable standing observations ----------------------------

Table integrations.standing_observation {
  ~immutable_record
  source_record_version_id uuid [not null, unique]
  display_name_snapshot varchar(255)
  subject_kind varchar(64) [not null]
  parsed_at timestamptz [not null]
}

Table integrations.standing_observation_entry {
  ~immutable_record
  standing_observation_id uuid [not null]
  sort_order integer [not null]
  position integer
  points numeric(12,4)

  driver_external_reference_id uuid
  team_external_reference_id uuid

  external_subject_id_snapshot varchar(255)
  subject_name_snapshot varchar(255) [not null]

  indexes {
    (standing_observation_id, sort_order) [unique, name: 'uq_standing_observation_entry_sort']
  }

  checks {
    `num_nonnull(driver_external_reference_id, team_external_reference_id) <= 1` [name: 'chk_standing_observation_at_most_one_resolved_subject']
  }
}

Table integrations.standing_revision_evidence {
  standing_revision_id uuid [not null]
  standing_observation_id uuid [not null]
  evidence_role varchar(64) [not null, default: 'supporting']

  indexes {
    (standing_revision_id, standing_observation_id) [pk]
  }
}


// ---- Reconciliation/review workflows ---------------------------------------

Table integrations.result_reconciliation_case {
  ~mutable_entity
  race_result_id uuid [not null]
  reason_code varchar(100) [not null, note: 'For example source_conflict or source_changed_after_manual_override']
  status integrations.reconciliation_status [not null, default: 'pending']
  detected_at timestamptz [not null]
  resolved_at timestamptz
  resolved_by_account_id uuid
  resolution_note text

  Note: 'Drives organizer/admin review when evidence conflicts or changes underneath an explicit manual correction.'
}

Table integrations.result_reconciliation_case_evidence {
  reconciliation_case_id uuid [not null]
  result_observation_id uuid [not null]

  indexes {
    (reconciliation_case_id, result_observation_id) [pk]
  }
}

Table integrations.standing_reconciliation_case {
  ~mutable_entity
  standing_id uuid [not null]
  reason_code varchar(100) [not null]
  status integrations.reconciliation_status [not null, default: 'pending']
  detected_at timestamptz [not null]
  resolved_at timestamptz
  resolved_by_account_id uuid
  resolution_note text
}

Table integrations.standing_reconciliation_case_evidence {
  reconciliation_case_id uuid [not null]
  standing_observation_id uuid [not null]

  indexes {
    (reconciliation_case_id, standing_observation_id) [pk]
  }
}


// ============================================================================
// AUDIT
// ============================================================================

Table audit.audit_event {
  ~immutable_record
  actor_account_id uuid
  action_code varchar(120) [not null]
  subject_type varchar(120) [not null]
  subject_id uuid [not null]
  metadata jsonb
  occurred_at timestamptz [not null]

  indexes {
    (subject_type, subject_id, occurred_at) [name: 'ix_audit_subject']
    (actor_account_id, occurred_at) [name: 'ix_audit_actor']
  }

  Note: '''
  Generic cross-cutting audit stream for user/admin mutations, merges, role changes and moderation actions.
  subject_id is intentionally polymorphic; this is an audit index, not a domain ownership relationship.
  '''
}


// ============================================================================
// REFERENCES
// ============================================================================

// Identity
Ref: identity.auth_identity.account_id > identity.account.id [delete: restrict]
Ref: identity.claim.account_id > identity.account.id [delete: restrict]
Ref: identity.claim.decided_by_account_id >? identity.account.id [delete: restrict]
Ref: identity.claim.target_driver_id >? drivers.driver.id [delete: restrict]
Ref: identity.claim.target_team_id >? teams.team.id [delete: restrict]
Ref: identity.claim.target_organisation_id >? organisations.organisation.id [delete: restrict]

Ref: identity.claim_evidence.claim_id > identity.claim.id [delete: cascade]
Ref: identity.claim_evidence.auth_identity_id >? identity.auth_identity.id [delete: restrict]
Ref: identity.claim_evidence.source_record_id >? integrations.source_record.id [delete: restrict]
Ref: identity.claim_evidence.provided_by_account_id >? identity.account.id [delete: restrict]

Ref: identity.driver_ownership.driver_id > drivers.driver.id [delete: restrict]
Ref: identity.driver_ownership.account_id > identity.account.id [delete: restrict]
Ref: identity.driver_ownership.approved_claim_id > identity.claim.id [delete: restrict]

// Driver
Ref: drivers.driver.merged_into_driver_id >? drivers.driver.id [delete: restrict]
Ref: drivers.driver_alias.driver_id > drivers.driver.id [delete: restrict]
Ref: drivers.driver_slug_history.driver_id > drivers.driver.id [delete: restrict]
Ref: drivers.driver_social_link.driver_id > drivers.driver.id [delete: restrict]

// Team
Ref: teams.team.merged_into_team_id >? teams.team.id [delete: restrict]
Ref: teams.team_name_history.team_id > teams.team.id [delete: restrict]
Ref: teams.team_slug_history.team_id > teams.team.id [delete: restrict]
Ref: teams.team_social_link.team_id > teams.team.id [delete: restrict]

Ref: teams.team_creation_request.claim_id > identity.claim.id [delete: restrict]
Ref: teams.team_creation_request.approved_team_id >? teams.team.id [delete: restrict]

Ref: teams.team_membership.team_id > teams.team.id [delete: restrict]
Ref: teams.team_membership.driver_id > drivers.driver.id [delete: restrict]
Ref: teams.team_membership.approved_request_id >? teams.team_membership_request.id [delete: restrict]
Ref: teams.team_membership.created_by_account_id >? identity.account.id [delete: restrict]

Ref: teams.team_membership_request.team_id > teams.team.id [delete: restrict]
Ref: teams.team_membership_request.driver_id > drivers.driver.id [delete: restrict]
Ref: teams.team_membership_request.requested_by_account_id > identity.account.id [delete: restrict]
Ref: teams.team_membership_request.responded_by_account_id >? identity.account.id [delete: restrict]
Ref: teams.team_membership_request.existing_membership_id >? teams.team_membership.id [delete: restrict]
Ref: teams.team_membership_request.applied_membership_id >? teams.team_membership.id [delete: restrict]

Ref: teams.roster_role.team_id > teams.team.id [delete: restrict]
Ref: teams.team_membership_role.(team_membership_id, team_id) > teams.team_membership.(id, team_id) [delete: restrict]
Ref: teams.team_membership_role.(roster_role_id, team_id) > teams.roster_role.(id, team_id) [delete: restrict]

Ref: teams.management_role.team_id > teams.team.id [delete: restrict]
Ref: teams.management_role_permission.management_role_id > teams.management_role.id [delete: cascade]
Ref: teams.management_role_permission.permission_code > teams.management_permission.code [delete: restrict]

Ref: teams.manager.team_id > teams.team.id [delete: restrict]
Ref: teams.manager.account_id > identity.account.id [delete: restrict]
Ref: teams.manager_role.(manager_id, team_id) > teams.manager.(id, team_id) [delete: restrict]
Ref: teams.manager_role.(management_role_id, team_id) > teams.management_role.(id, team_id) [delete: restrict]
Ref: teams.manager_role.assigned_by_account_id >? identity.account.id [delete: restrict]

// Organisation
Ref: organisations.organisation.merged_into_organisation_id >? organisations.organisation.id [delete: restrict]
Ref: organisations.organisation_name_history.organisation_id > organisations.organisation.id [delete: restrict]
Ref: organisations.organisation_slug_history.organisation_id > organisations.organisation.id [delete: restrict]
Ref: organisations.organisation_social_link.organisation_id > organisations.organisation.id [delete: restrict]

Ref: organisations.organisation_creation_request.claim_id > identity.claim.id [delete: restrict]
Ref: organisations.organisation_creation_request.approved_organisation_id >? organisations.organisation.id [delete: restrict]

Ref: organisations.role.organisation_id > organisations.organisation.id [delete: restrict]
Ref: organisations.role_permission.role_id > organisations.role.id [delete: cascade]
Ref: organisations.role_permission.permission_code > organisations.permission.code [delete: restrict]

Ref: organisations.member.organisation_id > organisations.organisation.id [delete: restrict]
Ref: organisations.member.account_id > identity.account.id [delete: restrict]
Ref: organisations.member_role.(member_id, organisation_id) > organisations.member.(id, organisation_id) [delete: restrict]
Ref: organisations.member_role.(role_id, organisation_id) > organisations.role.(id, organisation_id) [delete: restrict]
Ref: organisations.member_role.assigned_by_account_id >? identity.account.id [delete: restrict]

// Catalog
Ref: catalog.game.merged_into_game_id >? catalog.game.id [delete: restrict]
Ref: catalog.car.game_id > catalog.game.id [delete: restrict]
Ref: catalog.car.merged_into_car_id >? catalog.car.id [delete: restrict]
Ref: catalog.car_class.game_id > catalog.game.id [delete: restrict]
Ref: catalog.car_class.merged_into_car_class_id >? catalog.car_class.id [delete: restrict]
Ref: catalog.circuit.merged_into_circuit_id >? catalog.circuit.id [delete: restrict]
Ref: catalog.circuit_layout.circuit_id > catalog.circuit.id [delete: restrict]
Ref: catalog.circuit_layout.merged_into_circuit_layout_id >? catalog.circuit_layout.id [delete: restrict]

// Competition
Ref: competitions.competition.game_id > catalog.game.id [delete: restrict]
Ref: competitions.competition.merged_into_competition_id >? competitions.competition.id [delete: restrict]
Ref: competitions.competition_slug_history.competition_id > competitions.competition.id [delete: restrict]

Ref: competitions.competition_organisation.competition_id > competitions.competition.id [delete: restrict]
Ref: competitions.competition_organisation.organisation_id > organisations.organisation.id [delete: restrict]

Ref: competitions.competition_class.competition_id > competitions.competition.id [delete: restrict]
Ref: competitions.competition_class.car_class_id >? catalog.car_class.id [delete: restrict]

Ref: competitions.round.competition_id > competitions.competition.id [delete: restrict]
Ref: competitions.round.merged_into_round_id >? competitions.round.id [delete: restrict]

Ref: competitions.race.competition_id > competitions.competition.id [delete: restrict]
Ref: competitions.race.merged_into_race_id >? competitions.race.id [delete: restrict]
Ref: competitions.race.circuit_id >? catalog.circuit.id [delete: restrict]

// Round must belong to the same Competition as Race.
Ref: competitions.race.(round_id, competition_id) >? competitions.round.(id, competition_id) [delete: restrict]

// CircuitLayout must belong to Race.circuit_id.
Ref: competitions.race.(circuit_layout_id, circuit_id) >? catalog.circuit_layout.(id, circuit_id) [delete: restrict]

// Results
Ref: results.race_result.race_id > competitions.race.id [delete: restrict]
Ref: results.result_revision.race_result_id > results.race_result.id [delete: restrict]
Ref: results.result_revision.created_by_account_id >? identity.account.id [delete: restrict]

// Current revision must be a revision of the same RaceResult.
Ref: results.race_result.(current_revision_id, id) >? results.result_revision.(id, race_result_id) [delete: restrict]

Ref: results.result_entry.result_revision_id > results.result_revision.id [delete: restrict]
Ref: results.result_entry.team_id >? teams.team.id [delete: restrict]
Ref: results.result_entry.car_id >? catalog.car.id [delete: restrict]
Ref: results.result_entry.competition_class_id >? competitions.competition_class.id [delete: restrict]

Ref: results.result_entry_driver.result_entry_id > results.result_entry.id [delete: restrict]
Ref: results.result_entry_driver.driver_id >? drivers.driver.id [delete: restrict]

Ref: results.standing.competition_id > competitions.competition.id [delete: restrict]
Ref: results.standing.competition_class_id >? competitions.competition_class.id [delete: restrict]

Ref: results.standing_revision.standing_id > results.standing.id [delete: restrict]
Ref: results.standing_revision.created_by_account_id >? identity.account.id [delete: restrict]

// Current revision must be a revision of the same Standing.
Ref: results.standing.(current_revision_id, id) >? results.standing_revision.(id, standing_id) [delete: restrict]

Ref: results.standing_entry.standing_revision_id > results.standing_revision.id [delete: restrict]
Ref: results.standing_entry.driver_id >? drivers.driver.id [delete: restrict]
Ref: results.standing_entry.team_id >? teams.team.id [delete: restrict]

// Integration source/version
Ref: integrations.import_batch.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.source_record.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.source_record_version.source_record_id > integrations.source_record.id [delete: restrict]
Ref: integrations.source_record_version.import_batch_id > integrations.import_batch.id [delete: restrict]

// Current version must be a version of the same SourceRecord.
Ref: integrations.source_record.(current_version_id, id) >? integrations.source_record_version.(id, source_record_id) [delete: restrict]

// Typed references: source_system_id is intentionally repeated to enforce source consistency.
Ref: integrations.driver_external_reference.(source_record_id, source_system_id) > integrations.source_record.(id, source_system_id) [delete: restrict]
Ref: integrations.driver_external_reference.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.driver_external_reference.driver_id > drivers.driver.id [delete: restrict]

Ref: integrations.team_external_reference.(source_record_id, source_system_id) > integrations.source_record.(id, source_system_id) [delete: restrict]
Ref: integrations.team_external_reference.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.team_external_reference.team_id > teams.team.id [delete: restrict]

Ref: integrations.team_membership_external_reference.(source_record_id, source_system_id) > integrations.source_record.(id, source_system_id) [delete: restrict]
Ref: integrations.team_membership_external_reference.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.team_membership_external_reference.team_membership_id > teams.team_membership.id [delete: restrict]

Ref: integrations.organisation_external_reference.(source_record_id, source_system_id) > integrations.source_record.(id, source_system_id) [delete: restrict]
Ref: integrations.organisation_external_reference.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.organisation_external_reference.organisation_id > organisations.organisation.id [delete: restrict]

Ref: integrations.competition_external_reference.(source_record_id, source_system_id) > integrations.source_record.(id, source_system_id) [delete: restrict]
Ref: integrations.competition_external_reference.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.competition_external_reference.competition_id > competitions.competition.id [delete: restrict]

Ref: integrations.competition_class_external_reference.(source_record_id, source_system_id) > integrations.source_record.(id, source_system_id) [delete: restrict]
Ref: integrations.competition_class_external_reference.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.competition_class_external_reference.competition_class_id > competitions.competition_class.id [delete: restrict]

Ref: integrations.round_external_reference.(source_record_id, source_system_id) > integrations.source_record.(id, source_system_id) [delete: restrict]
Ref: integrations.round_external_reference.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.round_external_reference.round_id > competitions.round.id [delete: restrict]

Ref: integrations.race_external_reference.(source_record_id, source_system_id) > integrations.source_record.(id, source_system_id) [delete: restrict]
Ref: integrations.race_external_reference.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.race_external_reference.race_id > competitions.race.id [delete: restrict]

Ref: integrations.result_external_reference.(source_record_id, source_system_id) > integrations.source_record.(id, source_system_id) [delete: restrict]
Ref: integrations.result_external_reference.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.result_external_reference.race_result_id > results.race_result.id [delete: restrict]

Ref: integrations.standing_external_reference.(source_record_id, source_system_id) > integrations.source_record.(id, source_system_id) [delete: restrict]
Ref: integrations.standing_external_reference.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.standing_external_reference.standing_id > results.standing.id [delete: restrict]

Ref: integrations.game_external_reference.(source_record_id, source_system_id) > integrations.source_record.(id, source_system_id) [delete: restrict]
Ref: integrations.game_external_reference.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.game_external_reference.game_id > catalog.game.id [delete: restrict]

Ref: integrations.car_external_reference.(source_record_id, source_system_id) > integrations.source_record.(id, source_system_id) [delete: restrict]
Ref: integrations.car_external_reference.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.car_external_reference.car_id > catalog.car.id [delete: restrict]

Ref: integrations.car_class_external_reference.(source_record_id, source_system_id) > integrations.source_record.(id, source_system_id) [delete: restrict]
Ref: integrations.car_class_external_reference.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.car_class_external_reference.car_class_id > catalog.car_class.id [delete: restrict]

Ref: integrations.circuit_external_reference.(source_record_id, source_system_id) > integrations.source_record.(id, source_system_id) [delete: restrict]
Ref: integrations.circuit_external_reference.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.circuit_external_reference.circuit_id > catalog.circuit.id [delete: restrict]

Ref: integrations.circuit_layout_external_reference.(source_record_id, source_system_id) > integrations.source_record.(id, source_system_id) [delete: restrict]
Ref: integrations.circuit_layout_external_reference.source_system_id > integrations.source_system.id [delete: restrict]
Ref: integrations.circuit_layout_external_reference.circuit_layout_id > catalog.circuit_layout.id [delete: restrict]

// Normalized observations
Ref: integrations.result_observation.source_record_version_id > integrations.source_record_version.id [delete: restrict]
Ref: integrations.result_observation_entry.result_observation_id > integrations.result_observation.id [delete: restrict]
Ref: integrations.result_observation_entry.team_external_reference_id >? integrations.team_external_reference.id [delete: restrict]
Ref: integrations.result_observation_entry.car_external_reference_id >? integrations.car_external_reference.id [delete: restrict]
Ref: integrations.result_observation_entry.competition_class_external_reference_id >? integrations.competition_class_external_reference.id [delete: restrict]

Ref: integrations.result_observation_driver.result_observation_entry_id > integrations.result_observation_entry.id [delete: restrict]
Ref: integrations.result_observation_driver.driver_external_reference_id >? integrations.driver_external_reference.id [delete: restrict]

Ref: integrations.result_revision_evidence.result_revision_id > results.result_revision.id [delete: restrict]
Ref: integrations.result_revision_evidence.result_observation_id > integrations.result_observation.id [delete: restrict]

Ref: integrations.standing_observation.source_record_version_id > integrations.source_record_version.id [delete: restrict]
Ref: integrations.standing_observation_entry.standing_observation_id > integrations.standing_observation.id [delete: restrict]
Ref: integrations.standing_observation_entry.driver_external_reference_id >? integrations.driver_external_reference.id [delete: restrict]
Ref: integrations.standing_observation_entry.team_external_reference_id >? integrations.team_external_reference.id [delete: restrict]

Ref: integrations.standing_revision_evidence.standing_revision_id > results.standing_revision.id [delete: restrict]
Ref: integrations.standing_revision_evidence.standing_observation_id > integrations.standing_observation.id [delete: restrict]

// Reconciliation cases
Ref: integrations.result_reconciliation_case.race_result_id > results.race_result.id [delete: restrict]
Ref: integrations.result_reconciliation_case.resolved_by_account_id >? identity.account.id [delete: restrict]
Ref: integrations.result_reconciliation_case_evidence.reconciliation_case_id > integrations.result_reconciliation_case.id [delete: cascade]
Ref: integrations.result_reconciliation_case_evidence.result_observation_id > integrations.result_observation.id [delete: restrict]

Ref: integrations.standing_reconciliation_case.standing_id > results.standing.id [delete: restrict]
Ref: integrations.standing_reconciliation_case.resolved_by_account_id >? identity.account.id [delete: restrict]
Ref: integrations.standing_reconciliation_case_evidence.reconciliation_case_id > integrations.standing_reconciliation_case.id [delete: cascade]
Ref: integrations.standing_reconciliation_case_evidence.standing_observation_id > integrations.standing_observation.id [delete: restrict]

// Audit
Ref: audit.audit_event.actor_account_id >? identity.account.id [delete: restrict]


// ============================================================================
// TABLE GROUPS
// ============================================================================

TableGroup identity_and_claims [note: 'Authentication, profile claims and claim evidence'] {
  identity.account
  identity.auth_identity
  identity.claim
  identity.claim_evidence
  identity.driver_ownership
}

TableGroup driver_registry [note: 'Canonical public Driver identity and presentation'] {
  drivers.driver
  drivers.driver_alias
  drivers.driver_slug_history
  drivers.driver_social_link
}

TableGroup team_management [note: 'Teams, explicit membership history, requests, roster roles and management permissions'] {
  teams.team
  teams.team_name_history
  teams.team_slug_history
  teams.team_social_link
  teams.team_creation_request
  teams.team_membership
  teams.team_membership_request
  teams.roster_role
  teams.team_membership_role
  teams.management_permission
  teams.management_role
  teams.management_role_permission
  teams.manager
  teams.manager_role
}

TableGroup organisation_management [note: 'Organisations, staff membership and Discord-like roles/permissions'] {
  organisations.organisation
  organisations.organisation_name_history
  organisations.organisation_slug_history
  organisations.organisation_social_link
  organisations.organisation_creation_request
  organisations.permission
  organisations.role
  organisations.role_permission
  organisations.member
  organisations.member_role
}

TableGroup competition_structure [note: 'Source-backed competition structure; no invented Season or mandatory Round'] {
  competitions.competition
  competitions.competition_slug_history
  competitions.competition_organisation
  competitions.competition_class
  competitions.round
  competitions.race
}

TableGroup results_and_standings [note: 'Immutable canonical revisions for results and standings'] {
  results.race_result
  results.result_revision
  results.result_entry
  results.result_entry_driver
  results.standing
  results.standing_revision
  results.standing_entry
}

TableGroup integration_and_provenance [note: 'Raw source history, typed canonical mappings, normalized observations and reconciliation'] {
  integrations.source_system
  integrations.import_batch
  integrations.source_record
  integrations.source_record_version
  integrations.driver_external_reference
  integrations.team_external_reference
  integrations.team_membership_external_reference
  integrations.organisation_external_reference
  integrations.competition_external_reference
  integrations.competition_class_external_reference
  integrations.round_external_reference
  integrations.race_external_reference
  integrations.result_external_reference
  integrations.standing_external_reference
  integrations.game_external_reference
  integrations.car_external_reference
  integrations.car_class_external_reference
  integrations.circuit_external_reference
  integrations.circuit_layout_external_reference
  integrations.result_observation
  integrations.result_observation_entry
  integrations.result_observation_driver
  integrations.result_revision_evidence
  integrations.standing_observation
  integrations.standing_observation_entry
  integrations.standing_revision_evidence
  integrations.result_reconciliation_case
  integrations.result_reconciliation_case_evidence
  integrations.standing_reconciliation_case
  integrations.standing_reconciliation_case_evidence
}

TableGroup motorsport_catalog [note: 'Games, game-specific cars/classes and canonical circuits/layouts'] {
  catalog.game
  catalog.car
  catalog.car_class
  catalog.circuit
  catalog.circuit_layout
}

TableGroup auditing [note: 'Cross-cutting user/admin audit history'] {
  audit.audit_event
}


